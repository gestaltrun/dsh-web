{
  "name": "dsh-web",
  "version": "0.1.1",
  "private": true,
  "description": "DeepSeek Harness Web GUI \u63d2\u4ef6\u5168\u5bb6\u6876 + \u76ae\u80a4\u96c6\u5408\u3002\u76ae\u80a4\u662f\u7eaf\u8d44\u4ea7\u76ee\u5f55\uff08packages/skins/skin-center/skins/<id>\uff09\uff0c\u7531\u76ae\u80a4\u4e2d\u5fc3\u5305\u7edf\u4e00\u52a0\u8f7d\u3002",
  "dsh": {
    "bundle": {
      "patch": "./packages/dsh-web-all/cordis.patch.yml"
    }
  },
  "files": [
    "package.json",
    "packages/dsh-web-all/cordis.patch.yml"
  ],
  "dependencies": {
    "@gestaltrun/dsh-web-all": "0.3.23-gestaltrun.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev:watch": "node scripts/dev-watch.mjs",
    "test": "pnpm -r test",
    "test:desktop": "node --test desktop/tests/*.test.mjs",
    "typecheck": "pnpm -r typecheck",
    "aggregate:check": "node scripts/aggregate.mjs --check",
    "skin-center:check": "node scripts/skin-center-catalog-check --check",
    "skin-hooks:generate": "node scripts/skin-hooks-registry.mjs",
    "skin-hooks:check": "node scripts/skin-hooks-registry.mjs --check",
    "community:check": "node scripts/community-index --check",
    "runtime-deps:check": "node scripts/runtime-deps-check.mjs",
    "libs:check": "node scripts/lib-artifact-check.mjs",
    "libs:write": "node scripts/lib-artifact-check.mjs --write",
    "i18n:check": "node scripts/i18n-audit.mjs --check",
    "test:scripts": "node --test scripts/*.test.mjs",
    "test:mount": "bash scripts/e2e-mount.sh",
    "skin:new": "node scripts/dsh-skin-new",
    "pr:review": "node scripts/pr-review.mjs",
    "docs:check": "node scripts/verify-docs.mjs",
    "docs:list": "node scripts/verify-docs.mjs --list",
    "docs:write-pair": "node scripts/verify-docs.mjs --write",
    "sync-shared": "node scripts/sync-shared.mjs",
    "sync-shared:check": "node scripts/sync-shared.mjs --check",
    "market:build": "node scripts/market-build",
    "market:check": "node scripts/market-build --check",
    "deploy:market": "node scripts/deploy-market",
    "release:pack": "node scripts/release-pack.mjs",
    "release:publish": "node scripts/release-publish.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-api-session-controller": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-brand": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-llm": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-scope": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-session": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-settings": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-subagent": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-timeout": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-util-crypto": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-util-time": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-util-values": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-workspace": "^0.1.5-rc.1",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@playwright/test": "^1.62.1",
    "fflate": "^0.8.3",
    "lightningcss": "^1.32.0",
    "playwright": "^1.62.1",
    "tsdown": "^0.22.2"
  },
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.24.0"
}
