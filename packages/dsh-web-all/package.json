{
  "name": "@gestaltrun/dsh-web-all",
  "description": "DSH Web UI 全家桶聚合插件：一键安装全部功能插件（task-board / git-graph / pet / remote-web-ui / web-ui-settings / skin-center / community-plugins / compat shim）。compat 桥接层已并入本包（src/client），无需独立 compat npm 包。",
  "version": "0.3.23-gestaltrun.0",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./shell": "./lib/shell.js",
    "./degraded": "./lib/degraded.js",
    "./package.json": "./package.json",
    "./community-plugins": "./lib/shells/shell.js",
    "./describe-image": "./lib/shells/shell.js",
    "./doctor": "./lib/shells/shell.js",
    "./git-graph": "./lib/shells/shell.js",
    "./liangshen": "./lib/shells/shell.js",
    "./market": "./lib/shells/shell.js",
    "./pet": "./lib/shells/shell.js",
    "./plugin-manager": "./lib/shells/shell.js",
    "./remote-web-ui": "./lib/shells/shell.js",
    "./session-archive": "./lib/shells/shell.js",
    "./settings": "./lib/shells/shell.js",
    "./skill-explorer": "./lib/shells/shell.js",
    "./skin-center": "./lib/shells/shell.js",
    "./ssh": "./lib/shells/shell.js",
    "./task-board": "./lib/shells/shell.js",
    "./usage": "./lib/shells/shell.js",
    "./desktop-launcher": "./lib/shells/shell.js",
    "./dsh-perf": "./lib/shells/shell.js",
    "./model-capabilities": "./lib/shells/shell.js",
    "./preset-center": "./lib/shells/shell.js"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.1.5-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "prepare": "tsdown",
    "typecheck": "tsc --noEmit",
    "watch": "tsdown --watch"
  },
  "license": "Apache-2.0",
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/gestaltrun/dsh-web.git"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-api-session-controller": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-attachment": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-invariants": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-llm": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-scope": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-session": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-settings": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-subagent": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-system-prompt": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-util-time": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-workspace": "^0.1.5-rc.1",
    "@types/node": "^22.20.0",
    "jsdom": "29.1.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "@gestaltrun/dsh-client-ui-plugin-manager": "workspace:*",
    "@gestaltrun/dsh-client-ui-community-plugins": "workspace:*",
    "@gestaltrun/dsh-client-ui-market": "workspace:*",
    "@gestaltrun/dsh-client-ui-task-board": "workspace:*",
    "@gestaltrun/dsh-client-ui-git-graph": "workspace:*",
    "@gestaltrun/dsh-pet": "workspace:*",
    "@gestaltrun/dsh-remote-web-ui": "workspace:*",
    "@gestaltrun/dsh-ssh": "workspace:*",
    "@gestaltrun/dsh-tool-describe-image": "workspace:*",
    "@gestaltrun/dsh-liangshen": "workspace:*",
    "@gestaltrun/dsh-client-ui-skill-explorer": "workspace:*",
    "@gestaltrun/dsh-doctor": "workspace:*",
    "@gestaltrun/dsh-usage": "workspace:*",
    "@gestaltrun/dsh-session-archive": "workspace:*",
    "@gestaltrun/dsh-client-ui-model-capabilities": "workspace:*",
    "@gestaltrun/dsh-client-ui-preset-center": "workspace:*",
    "@gestaltrun/dsh-client-ui-web-ui-settings": "workspace:*",
    "@gestaltrun/dsh-client-ui-skin-center": "workspace:*",
    "@gestaltrun/dsh-i18n": "workspace:*",
    "@gestaltrun/dsh-better-sidebar": "0.19.1-gestaltrun.0"
  }
}
